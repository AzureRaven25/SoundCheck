.DS_Store
# Processed song bundles and source audio never go in git. Anchored to their real locations: a bare `library/`
# also matched the website's /library page (apps/web/src/app/library), so it was never committed or deployed.
/library/
services/pipeline/library/
/music/
*.mp3
*.flac
*.m4a
*.wav
/data/
.claude/
__pycache__/
.venv/
.pytest_cache/
.reference/
node_modules/
*.tsbuildinfo
.env
.env.*
!.env.example

# Apple apps: generated project, build output, local config
apps/apple/*.xcodeproj/
apps/apple/**/.build/
apps/apple/**/.swiftpm/
apps/apple/Config/Local.xcconfig
apps/apple/Config/Release.local.xcconfig
DerivedData/
apps/android/secrets.properties
.vercel/
.vercel
.env*
