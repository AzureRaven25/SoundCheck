# SoundCheck environment. Copy to .env.local (gitignored) and fill in.
# Get the keys with:  supabase projects api-keys --project-ref ppmzqjrfcbemzzbwicrd
# (run it yourself in a terminal; never paste keys into chat or commit them)

SUPABASE_URL=https://ppmzqjrfcbemzzbwicrd.supabase.co

# Safe in clients (web, TV, mobile): every table is protected by RLS.
SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY: GPU worker, catalog sync scripts, Edge Function secrets. Never in client code or apps.
SUPABASE_SECRET_KEY=

# Long-tail catalog search tier (Turso). Create a token yourself:  turso db tokens create soundcheck
TURSO_DATABASE_URL=libsql://soundcheck-azureraven25.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=

# ---- Official listening providers (server-side only: `supabase secrets set NAME=value`) -------------------
# YouTube Data API v3 key (Google Cloud console → APIs & Services → YouTube Data API v3 → Credentials).
# Enables automatic video search on song pages; without it people can still paste a YouTube link.
YOUTUBE_API_KEY=
# Apple Music / MusicKit (Apple Developer Program → Certificates, IDs & Profiles → Keys → MusicKit).
# Full-song playback for Apple Music subscribers. The private key is the .p8 file's contents.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
# Sites allowed to use the MusicKit token (comma-separated).
APPLE_MUSIC_ORIGINS=https://soundcheck-gules.vercel.app,http://localhost:3000

# Jamendo API (free client_id from https://devportal.jamendo.com). Optional: Jamendo is also reached via Openverse.
# Set as a Supabase secret: supabase secrets set JAMENDO_CLIENT_ID=...
JAMENDO_CLIENT_ID=
